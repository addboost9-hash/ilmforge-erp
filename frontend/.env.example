# Local development — the backend running on your own machine.
VITE_API_URL=http://localhost:5000/api/v1

# PRODUCTION
# Vercel builds with the VITE_API_URL set in its own Project Settings, not with
# any file in this repo (.env.production is gitignored). That dashboard value is
# the authoritative one — if it is ever cleared, the build silently falls back
# to the localhost URL above and the deployed site cannot reach any API.
#
# Correct production value:
#   VITE_API_URL=https://ilmforge-erp.onrender.com/api/v1
#
# Note: ilmforge-api.onrender.com does NOT exist and returns 404. The repo's
# .env.production pointed there for a while; production was unaffected only
# because Vercel never used that file.
